            "name": "churn_rate",
            "dataType": "double",
            "sourceColumn": "churn_rate",
            "summarizeBy": "average",
            "formatString": "0.0%"
          }
        ],
        "partitions": [
          {
            "name": "dim_segment_perf",
            "mode": "import",
            "source": [
              {
                "type": "m",
                "expression": [
                  "let",
                  "    Source = Csv.Document(",
                  "        File.Contents(MartsFolder & \"segment_performance.csv\"),",
                  "        [Delimiter=\",\", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.Csv]",
                  "    ),",
                  "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                  "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\", {{\"segment\", type text}, {\"region\", type text}, {\"plan\", type text}, {\"customers\", Int64.Type}, {\"active_customers\", Int64.Type}, {\"churned\", Int64.Type}, {\"total_mrr\", type number}, {\"avg_mrr\", type number}, {\"avg_health\", type number}, {\"avg_nps\", type number}, {\"lifetime_revenue\", type number}, {\"churn_rate\", type number}})",
                  "in",
                  "    #\"Changed Type\""
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "fact_support_sla",
        "columns": [
          {
            "name": "event_id",
            "dataType": "string",
            "sourceColumn": "event_id",
            "summarizeBy": "none"
          },
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "opened_at",
            "dataType": "dateTime",
            "sourceColumn": "opened_at",
            "summarizeBy": "none",
            "formatString": "General Date"
          },
          {
            "name": "resolved_at",
            "dataType": "dateTime",
            "sourceColumn": "resolved_at",
            "summarizeBy": "none",
            "formatString": "General Date"
          },
          {
            "name": "sla_due_at",
            "dataType": "dateTime",
            "sourceColumn": "sla_due_at",
            "summarizeBy": "none",
            "formatString": "General Date"
          },
          {
            "name": "opened_date",
            "dataType": "dateTime",
            "sourceColumn": "opened_date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "priority",
            "dataType": "string",
            "sourceColumn": "priority",
            "summarizeBy": "none"
          },
          {
            "name": "reason",
            "dataType": "string",
            "sourceColumn": "reason",
            "summarizeBy": "none"
          },
          {
            "name": "category",
            "dataType": "string",
            "sourceColumn": "category",
            "summarizeBy": "none"
          },
          {
            "name": "channel",
            "dataType": "string",
            "sourceColumn": "channel",
            "summarizeBy": "none"
          },
          {
            "name": "csat",
            "dataType": "double",
            "sourceColumn": "csat",
            "summarizeBy": "average",
            "formatString": "0.0"
          },
          {
            "name": "resolved_hours",
            "dataType": "double",
            "sourceColumn": "resolved_hours",
            "summarizeBy": "average",
            "formatString": "0.0"
          },
          {
            "name": "age_hours",
            "dataType": "double",
            "sourceColumn": "age_hours",
            "summarizeBy": "average",
            "formatString": "0.0"
          },
          {
            "name": "is_open",
            "dataType": "int64",
            "sourceColumn": "is_open",
            "summarizeBy": "sum",
            "formatString": "0"
          },
          {
            "name": "sla_breach",
            "dataType": "boolean",
            "sourceColumn": "sla_breach",
            "summarizeBy": "none"
          },
          {
            "name": "sla_status",
            "dataType": "string",
            "sourceColumn": "sla_status",
            "summarizeBy": "none"
          },
          {
            "name": "segment",
            "dataType": "string",
            "sourceColumn": "segment",
            "summarizeBy": "none"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          },
          {
            "name": "plan",
            "dataType": "string",
            "sourceColumn": "plan",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Ticket Volume",
            "expression": [
              "COUNTROWS ( fact_support_sla )"
            ],
            "formatString": "#,##0"
          },
          {
            "name": "Avg CSAT",
            "expression": [
              "AVERAGE ( fact_support_sla[csat] )"
            ],
            "formatString": "0.00"
          },
          {
            "name": "Within SLA %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( COUNTROWS ( fact_support_sla ), fact_support_sla[sla_status] = \"within_sla\" ),",
              "    CALCULATE ( COUNTROWS ( fact_support_sla ), fact_support_sla[is_open] = 0 )",
              ")"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Pending Tickets",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( fact_support_sla ),",
              "    fact_support_sla[status] IN { \"pending\", \"escalated\" }",
              ")"
            ],
            "formatString": "#,##0"
          },
          {
            "name": "Open Tickets",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_support_sla ), fact_support_sla[is_open] = 1 )"
            ],
            "formatString": "#,##0"
          },
          {
            "name": "Avg Resolve Hours",
            "expression": [
              "AVERAGE ( fact_support_sla[resolved_hours] )"
            ],
            "formatString": "0.0"
          },
          {
            "name": "Breach Count",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_support_sla ), fact_support_sla[sla_breach] = TRUE () )"
            ],
            "formatString": "#,##0"
          },
          {
            "name": "Beyond Aging Threshold",
            "expression": [
              "VAR Threshold = [Aging Threshold Hours]",
              "RETURN",
              "    CALCULATE (",
              "        COUNTROWS ( fact_support_sla ),",
              "        fact_support_sla[is_open] = 1,",
              "        fact_support_sla[age_hours] >= Threshold",
              "    )"
            ],
            "formatString": "#,##0"
          }
        ],
        "partitions": [
          {
            "name": "fact_support_sla",
            "mode": "import",
            "source": [
              {
                "type": "m",
                "expression": [
                  "let",
                  "    Source = Csv.Document(",
                  "        File.Contents(MartsFolder & \"support_sla.csv\"),",
                  "        [Delimiter=\",\", Columns=20, Encoding=65001, QuoteStyle=QuoteStyle.Csv]",
                  "    ),",
                  "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                  "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\", {{\"event_id\", type text}, {\"customer_id\", type text}, {\"opened_at\", type datetime}, {\"resolved_at\", type datetime}, {\"sla_due_at\", type datetime}, {\"opened_date\", type date}, {\"status\", type text}, {\"priority\", type text}, {\"reason\", type text}, {\"category\", type text}, {\"channel\", type text}, {\"csat\", type number}, {\"resolved_hours\", type number}, {\"age_hours\", type number}, {\"is_open\", Int64.Type}, {\"sla_breach\", type logical}, {\"sla_status\", type text}, {\"segment\", type text}, {\"region\", type text}, {\"plan\", type text}})",
                  "in",
                  "    #\"Changed Type\""
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "Aging Threshold",
        "columns": [
          {
            "name": "Aging Threshold Hours",
            "dataType": "int64",
            "isNameInferred": false,
            "isDataTypeInferred": false,
            "formatString": "0",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "partitions": [
          {
            "name": "Aging Threshold",
            "mode": "import",
            "source": [
              {
                "type": "calculated",
                "expression": [
                  "DATATABLE ( \"Aging Threshold Hours\", INTEGER, {{72}} )"
                ]
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "Aging Threshold Hours",
            "expression": [
              "SELECTEDVALUE ( 'Aging Threshold'[Aging Threshold Hours], 72 )"
            ],
            "formatString": "0"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "rel_support_to_customer",
        "fromTable": "fact_support_sla",
        "fromColumn": "customer_id",
        "toTable": "fact_customer_360",
        "toColumn": "customer_id",
        "crossFilteringBehavior": "oneDirection"
      }
    ],
    "expressions": [
      {
        "name": "MartsFolder",
        "kind": "m",
        "expression": [
          "\"./../data/\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"MartsFolder\", \"fact_customer_360\", \"fact_mrr_movement\", \"fact_retention_monthly\", \"fact_revenue_cohorts\", \"fact_product_revenue\", \"dim_segment_perf\", \"fact_support_sla\"]"
      }
    ]
  }

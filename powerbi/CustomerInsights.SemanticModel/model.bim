            "sourceColumn": "product",
            "summarizeBy": "none"
          },
          {
            "name": "revenue",
            "dataType": "double",
            "sourceColumn": "revenue",
            "summarizeBy": "sum",
            "formatString": "#,##0.00"
          },
          {
            "name": "txn_count",
            "dataType": "int64",
            "sourceColumn": "txn_count",
            "summarizeBy": "sum",
            "formatString": "0"
          },
          {
            "name": "customers",
